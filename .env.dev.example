# Local docker-compose.dev.yml defaults. Copy to .env.dev (gitignored):
#   cp .env.dev.example .env.dev
#   docker compose -f docker-compose.dev.yml --env-file .env.dev up --build

# ── App Postgres ───────────────────────────────────────────────────────────────
POSTGRES_USER=azureadmin
POSTGRES_PASSWORD=azureadmin
POSTGRES_DB=azureadmin

# ── Azure DevOps ───────────────────────────────────────────────────────────────
AZURE_DEVOPS_API_VERSION=7.1

# ── Keycloak (matches docker/dev/keycloak/azure-admin-realm.json) ───────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_ID=azure-admin
KEYCLOAK_CLIENT_SECRET=local-dev-secret-change-me
