# Angular SPA served by nginx (proxies /api to backend). Build from repo root:
#   docker build -f Dockerfile.frontend .
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY angular.json tsconfig.json tsconfig.app.json ngsw-config.json ./
COPY src ./src
COPY public ./public
RUN npm run build

FROM nginx:alpine
# CVE-2026-111497: nginx:alpine can ship brotli-libs older than the fixed 1.2.1 (via libcurl/freetype).
RUN apk upgrade --no-cache brotli-libs
COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/azure-admin/browser /usr/share/nginx/html

EXPOSE 80
