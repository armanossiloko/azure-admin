# Copy this file to .env and fill in the values.
# .env is gitignored — never commit secrets.

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Used by both the postgres container and the backend (via Postgres__* env vars).
POSTGRES_USER=azureadmin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=azureadmin

# ── Azure DevOps ───────────────────────────────────────────────────────────────
AZURE_DEVOPS_API_VERSION=7.1

# ── Keycloak / OpenID Connect ──────────────────────────────────────────────────
# Full realm URL, e.g. https://auth.example.com/realms/azure-admin
KEYCLOAK_AUTHORITY=https://auth.example.com/realms/azure-admin
KEYCLOAK_CLIENT_ID=azure-admin
KEYCLOAK_CLIENT_SECRET=change-me
# Set to false only if Keycloak runs on plain HTTP (non-production environments)
KEYCLOAK_REQUIRE_HTTPS_METADATA=true
