{
  "$schema": "./node_modules/ng-openapi-gen/ng-openapi-gen-schema.json",
  "input": "openapi/AzureAdmin.API.json",
  "output": "src/app/api/generated",
  "removeStaleFiles": true,
  "indexFile": true,
  "enumStyle": "alias",
  "skipJsonSuffix": true,
  "ignoreUnusedModels": false,
  "camelizeModelNames": true,
  "modelIndex": "models",
  "serviceIndex": "services",
  "endOfLineStyle": "lf",
  "services": true,
  "serviceSuffix": "Api",
  "functionIndex": "functions"
}
